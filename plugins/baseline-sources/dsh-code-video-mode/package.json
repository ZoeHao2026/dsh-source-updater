{
  "name": "@local/dsh-code-video-mode",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "DSH code-video agent mode: autonomous programmatic video production from a one-line brief to a final MP4.",
  "exports": {
    "./plan-entry": "./lib/plan-entry.js",
    "./render-capabilities": "./lib/render-capabilities.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/*.js",
    "mode/*.md",
    "templates/*",
    "verification/*.md",
    "playbooks/*.md",
    "skills/*/SKILL.md",
    "scripts/build-preset.mjs",
    "scripts/run-smoke.mjs",
    "scripts/smoke-lib.mjs",
    "README.md"
  ],
  "scripts": {
    "build:preset": "node scripts/build-preset.mjs",
    "smoke": "node scripts/run-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
