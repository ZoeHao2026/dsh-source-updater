+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { readDesktopSourceHealthRequest } from '../src/source-update-health.ts'
+
+const temporary: string[] = []
+afterEach(() => { vi.unstubAllEnvs(); for (const directory of temporary.splice(0)) rmSync(directory, { recursive: true, force: true }) })
+
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-source-health-'))
+  temporary.push(root)
+  vi.stubEnv('USERPROFILE', join(root, 'user'))
+  vi.stubEnv('APPDATA', join(root, 'roaming'))
+  vi.stubEnv('LOCALAPPDATA', join(root, 'local'))
+  vi.stubEnv('DSH_SOURCE_UPDATER_CONFIG', undefined)
+  const requestPath = join(root, 'request.json')
+  const request = { schemaVersion: 1, token: 'test-token-1234567890', receiptPath: join(root, 'receipt.json'), releasePath: join(root, 'release.json'),
+    homePath: join(root, 'snapshot', 'home'), userDataPath: join(root, 'snapshot', 'userData'), version: '0.2.1-alpha.5', commit: 'a'.repeat(40),
+    phase: 'isolated', plugins: [{ name: '@local/plugin', version: '1.0.0' }] }
+  const read = (changes: object = {}) => {
+    writeFileSync(requestPath, JSON.stringify({ ...request, ...changes }))
+    return readDesktopSourceHealthRequest([`--source-update-health=${requestPath}`])
+  }
+  const configPath = join(root, 'local', 'DSH Source Updater', 'updater-config.json')
+  const configure = (config: object, location = configPath): void => {
+    mkdirSync(dirname(location), { recursive: true })
+    writeFileSync(location, JSON.stringify(config))
+    writeFileSync(join(dirname(location), 'upgrade-worker.mjs'), '// Test helper discovery only.\n')
+  }
+  return { root, read, request, configure }
+}
+
+describe('health process data isolation', () => {
+  it('leaves ordinary launches alone and accepts isolated qualification requests', () => {
+    expect(readDesktopSourceHealthRequest(['--updated'])).toBeUndefined()
+    const f = fixture()
+    expect(f.read()).toMatchObject({ phase: 'isolated', homePath: f.request.homePath })
+  })
+
+  it('refuses the default live home, actual app settings directory, and configured live paths', () => {
+    const f = fixture()
+    expect(() => f.read({ homePath: join(f.root, 'user', '.dsh') })).toThrow('requires isolated')
+    expect(() => f.read({ userDataPath: join(f.root, 'roaming', '@deepseek-ai', 'dsh-desktop') })).toThrow('requires isolated')
+    f.configure({ sharedDataDir: f.request.homePath, userDataDir: f.request.userDataPath })
+    expect(() => f.read()).toThrow('requires isolated')
+  })
+
+  it('admits final validation only for the updater-configured matched data directories', () => {
+    const f = fixture()
+    expect(() => f.read({ phase: 'installed-final' })).toThrow('differ from updater')
+    f.configure({ sharedDataDir: f.request.homePath, userDataDir: f.request.userDataPath })
+    expect(f.read({ phase: 'installed-final' })).toMatchObject({ phase: 'installed-final' })
+    expect(() => f.read({ phase: 'installed-final', homePath: join(f.root, 'other') })).toThrow('differ from updater')
+  })
+
+  it('requires pinned identity and an explicit expected plugin inventory', () => {
+    const f = fixture()
+    expect(() => f.read({ commit: 'main' })).toThrow('invalid request identity')
+    expect(() => f.read({ plugins: [] })).toThrow('expected plugins missing')
+    expect(() => f.read({ token: '' })).toThrow('invalid request identity')
+    expect(() => f.read({ homePath: 'relative' })).toThrow('invalid homePath')
+  })
+
+  it('uses the Documents helper to validate final live-data paths', () => {
+    const f = fixture()
+    const documentsConfig = join(f.root, 'user', 'Documents', 'DSHUpdater', 'updater-config.json')
+    f.configure({ sharedDataDir: f.request.homePath, userDataDir: f.request.userDataPath }, documentsConfig)
+    f.configure({ sharedDataDir: join(f.root, 'wrong-home'), userDataDir: join(f.root, 'wrong-user-data') })
+    expect(f.read({ phase: 'installed-final' })).toMatchObject({ phase: 'installed-final' })
+  })
+
+  it('uses an explicit worker config for redirected Documents and never falls back when it is absent', () => {
+    const f = fixture()
+    const redirected = join(f.root, 'redirected-documents', 'DSHUpdater', 'updater-config.json')
+    f.configure({ sharedDataDir: f.request.homePath, userDataDir: f.request.userDataPath }, redirected)
+    vi.stubEnv('DSH_SOURCE_UPDATER_CONFIG', redirected)
+    expect(f.read({ phase: 'installed-final' })).toMatchObject({ phase: 'installed-final' })
+    f.configure({ sharedDataDir: f.request.homePath, userDataDir: f.request.userDataPath })
+    vi.stubEnv('DSH_SOURCE_UPDATER_CONFIG', join(f.root, 'missing', 'updater-config.json'))
+    expect(() => f.read({ phase: 'installed-final' })).toThrow('differ from updater')
+  })
+})
diff --git a/apps/desktop/tests/source-updater-paths.spec.ts b/apps/desktop/tests/source-updater-paths.spec.ts
