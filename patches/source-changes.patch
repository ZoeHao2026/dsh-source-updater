+import { spawn } from 'node:child_process'
+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterEach, describe, expect, it } from 'vitest'
+import { DesktopSourceUpdater, runDesktopSourceWorker } from '../src/source-updater.ts'
+
+const roots: string[] = []
+const target = { version: '0.2.1-alpha.6', tag: 'dsh-v0.2.1-alpha.6', commit: 'a'.repeat(40) }
+const repository = fileURLToPath(new URL('../../../', import.meta.url))
+const runnerModule = new URL('../src/source-updater.ts', import.meta.url).href
+
+async function waitForFile(filename: string, timeoutMs = 8_000): Promise<string> {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    try { return await readFile(filename, 'utf8') }
+    catch (error) {
+      if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error
+    }
+    await new Promise<void>(resolve => { setTimeout(resolve, 25) })
+  }
+  throw new Error(`Fixture deadline exceeded: ${filename}`)
+}
+
+afterEach(async () => {
+  for (const root of roots.splice(0)) {
+    let pid: number | undefined
+    try { pid = (JSON.parse(await readFile(join(root, 'started.json'), 'utf8')) as { pid: number }).pid }
+    catch (_error: unknown) { /* A failed spawn has no child to reclaim. */ }
+    if (pid !== undefined) {
+      try { process.kill(pid, 0); process.kill(pid) }
+      catch (_error: unknown) { /* Completed fixture workers have already exited. */ }
+      await new Promise<void>(resolve => { setTimeout(resolve, 50) })
+    }
+    await rm(root, { recursive: true, force: true })
+  }
+})
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-background-worker-'))
+  roots.push(root)
+  const paths = { worker: join(root, 'upgrade-worker.mjs'), config: join(root, 'updater-config.json') }
+  await writeFile(paths.config, JSON.stringify({ root, tools: { node: { executable: process.execPath } } }))
+  await writeFile(paths.worker, `
+    import * as fs from 'node:fs/promises';
+    import path from 'node:path';
+    const action = process.argv[2];
+    const config = JSON.parse(await fs.readFile(process.argv[process.argv.indexOf('--config') + 1], 'utf8'));
+    const root = config.root;
+    const target = ${JSON.stringify(target)};
+    const status = path.join(root, 'status.json');
+    const lock = path.join(root, 'worker.lock');
+    const readStatus = async () => JSON.parse(await fs.readFile(status, 'utf8'));
+    if (action === 'status') { process.stdout.write(JSON.stringify(await readStatus()) + '\\n'); process.exit(0); }
+    try { await fs.writeFile(lock, JSON.stringify({ pid: process.pid }), { flag: 'wx' }); }
+    catch (error) {
+      if (error.code !== 'EEXIST') throw error;
+      process.stdout.write(JSON.stringify({ ...await readStatus(), phase: 'busy' }) + '\\n');
+      process.exit(0);
+    }
+    await fs.writeFile(status, JSON.stringify({ phase: action === 'prepare' ? 'building' : 'checking', target }));
+    await fs.writeFile(path.join(root, 'started.json'), JSON.stringify({ pid: process.pid, action }));
+    if (action === 'prepare') {
+      const countPath = path.join(root, 'prepare-count');
+      const count = await fs.readFile(countPath, 'utf8').catch(() => '0');
+      await fs.writeFile(countPath, String(Number(count) + 1));
+    }
+    await new Promise(resolve => setTimeout(resolve, 1_200));
+    const result = { phase: action === 'prepare' ? 'ready' : 'current', target };
+    await fs.writeFile(status, JSON.stringify(result));
+    await fs.unlink(lock);
+    await fs.writeFile(path.join(root, 'completed.json'), JSON.stringify(result));
+    process.stdout.write(JSON.stringify(result) + '\\n');
+  `)
+  return { root, paths, executable: join(root, 'old-client.exe') }
+}
+
+async function runParent(f: Awaited<ReturnType<typeof fixture>>, action: 'check' | 'prepare', quitEarly: boolean): Promise<void> {
+  const parent = join(f.root, `parent-${action}.mjs`)
+  await writeFile(parent, `
+    import * as fs from 'node:fs/promises';
+    import { runDesktopSourceWorker } from ${JSON.stringify(runnerModule)};
+    const result = runDesktopSourceWorker(${JSON.stringify(f.executable)}, ${JSON.stringify(f.paths)}, ${JSON.stringify(action)}, { schemaVersion: 1 });
+    ${quitEarly ? `
+      result.catch(() => {});
+      for (;;) {
+        try { await fs.access(${JSON.stringify(join(f.root, 'started.json'))}); break; }
+        catch { await new Promise(resolve => setTimeout(resolve, 10)); }
+      }
+      process.exit(0);
+    ` : `await fs.writeFile(${JSON.stringify(join(f.root, 'parent-result.json'))}, JSON.stringify(await result));`}
+  `)
+  const child = spawn(process.execPath, ['--import', 'tsx/esm', parent], {
+    cwd: repository, stdio: ['ignore', 'ignore', 'pipe'], windowsHide: true,
+  })
+  let diagnostic = ''
+  child.stderr.setEncoding('utf8')
+  child.stderr.on('data', (chunk: string) => { diagnostic += chunk })
+  const exit = await new Promise<number | null>((resolve, reject) => {
+    child.once('error', reject)
+    child.once('close', (code) => { resolve(code) })
+  })
+  expect(exit, diagnostic).toBe(0)
+}
+
+describe('background source workers', () => {
+  it.each(['check', 'prepare'] as const)('keeps a standalone parent alive until %s completes and cleans only its output files', async (action) => {
+    const f = await fixture()
+    const unrelated = join(f.root, 'unrelated.stdout.log')
+    await writeFile(unrelated, 'keep')
+    await runParent(f, action, false)
+    expect(JSON.parse(await readFile(join(f.root, 'parent-result.json'), 'utf8'))).toMatchObject({ phase: action === 'prepare' ? 'ready' : 'current' })
+    expect((await readdir(f.root)).filter(name => /\.(?:stdout|stderr)\.log$/u.test(name))).toEqual(['unrelated.stdout.log'])
+    expect(await readFile(unrelated, 'utf8')).toBe('keep')
+  }, 15_000)
+
+  it.each(['check', 'prepare'] as const)('lets %s finish and release its private lock after the real parent process exits', async (action) => {
+    const f = await fixture()
+    await runParent(f, action, true)
+    expect((JSON.parse(await waitForFile(join(f.root, 'completed.json'))) as { phase: string }).phase).toBe(action === 'prepare' ? 'ready' : 'current')
+    expect(await readdir(f.root)).not.toContain('worker.lock')
+    expect((await readdir(f.root)).filter(name => /\.(?:stdout|stderr)\.log$/u.test(name))).toHaveLength(2)
+  }, 15_000)
+
+  it('joins an orphaned build through busy/status without starting another prepare', async () => {
+    const f = await fixture()
+    await runParent(f, 'prepare', true)
+    const phases: string[] = []
+    const updater = new DesktopSourceUpdater({ request: { schemaVersion: 1 },
+      run: (action, request, detached) => runDesktopSourceWorker(f.executable, f.paths, action, request, detached),
+      idleMilliseconds: () => 0, inspectInstall: async () => false, prepareInstall: async () => false, recoverInstall: async () => {}, quit: () => {},
+      publish: state => { phases.push(state.phase) },
+    })
+    try {
+      await updater.launch()
+      expect(phases).toContain('busy')
+      expect(updater.state.phase).toBe('ready')
+      expect(await readFile(join(f.root, 'prepare-count'), 'utf8')).toBe('1')
+      expect(await readdir(f.root)).not.toContain('worker.lock')
+    } finally { updater.dispose() }
+  }, 15_000)
+
+  it('reads failed-worker diagnostics from its file and releases handles before cleanup', async () => {
+    const f = await fixture()
+    await writeFile(f.paths.worker, "process.stderr.write('private fixture failure'); process.exit(3);\n")
+    await expect(runDesktopSourceWorker(f.executable, f.paths, 'prepare', { schemaVersion: 1 }))
+      .rejects.toThrow('private fixture failure')
+    expect((await readdir(f.root)).filter(name => /\.(?:stdout|stderr)\.log$/u.test(name))).toHaveLength(0)
+  })
+
+  it('releases both output handles when the configured worker executable cannot spawn', async () => {
+    const f = await fixture()
+    const invalidExecutable = join(f.root, 'invalid-node.exe')
+    await writeFile(invalidExecutable, 'not an executable')
+    await writeFile(f.paths.config, JSON.stringify({ tools: { node: { executable: invalidExecutable } } }))
+    await expect(runDesktopSourceWorker(f.executable, f.paths, 'check', {})).rejects.toThrow()
+    expect((await readdir(f.root)).filter(name => /\.(?:stdout|stderr)\.log$/u.test(name))).toHaveLength(0)
+  })
+})
