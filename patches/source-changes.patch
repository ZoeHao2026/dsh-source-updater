+    || typeof config.tools.node !== 'object' || config.tools.node === null || !('executable' in config.tools.node)
+    || typeof config.tools.node.executable !== 'string' || !isAbsolute(config.tools.node.executable)
+    || !existsSync(config.tools.node.executable) || resolve(config.tools.node.executable) === resolve(executable)) {
+    throw new Error('source updater: configure an independent Node executable outside the Desktop installation')
+  }
