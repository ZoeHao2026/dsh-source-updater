+          throw new DesktopSourceHandoffError('unknown', `source updater: Host recovery failed; inspect before retrying. ${recoveryError instanceof Error ? recoveryError.message : String(recoveryError)}`)
+        }
+      }
+      throw error
+    }
+    if (this.isDisposed()) return
+    this.publish({ phase: 'applying', target: ready.target })
+    this.dispose()
+    this.options.quit()
+  }
+}
