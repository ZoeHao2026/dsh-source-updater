+++ b/apps/desktop-host/tests/source-update-health.spec.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest'
+import type { Profile } from '@deepseek-ai/dsh-app-boot'
+import { FiberState } from '@deepseek-ai/cordis'
+import { disableDesktopSourceHealthSchedules, requireDesktopSourceHealthPlugins } from '../src/source-update-health.ts'
+
+function profile(): Profile {
+  return { name: 'desktop', dir: '/snapshot/desktop', patchPath: '/snapshot/desktop/cordis.patch.yml', skippedBundles: [],
+    patches: [{ insert: [{ id: 'renamed-schedule', name: '@deepseek-ai/dsh-schedule' }] }],
+    layers: [{ packageName: 'test', packageDir: '/snapshot/test', patchPaths: [], patches: [{ insert: [{ id: 'schedule', name: '@deepseek-ai/dsh-schedule' }] }] }] }
+}
+
+describe('isolated source health', () => {
+  it('disables built-in and custom scheduling rows before any plugin loads', () => {
+    const value = profile()
+    expect(disableDesktopSourceHealthSchedules(value)).toBe(2)
+    expect(value.patches.slice(-2)).toEqual([{ id: 'schedule', disabled: true }, { id: 'renamed-schedule', disabled: true }])
+    expect(value.layers[0]!.patches).toHaveLength(1)
+  })
+
+  it('refuses to qualify a scheduler without a stable row id', () => {
+    const value = profile()
+    // @ts-expect-error Exercise malformed persisted input without a row id.
+    value.patches.push({ insert: [{ name: '@deepseek-ai/dsh-schedule' }] })
+    expect(() => disableDesktopSourceHealthSchedules(value)).toThrow('no stable row id')
+  })
+
+  it('requires the actual selected plugin Host row to reach active state', () => {
+    const value = profile()
+    const entry = { id: 'schedule', name: '@deepseek-ai/dsh-schedule', disabled: false, state: FiberState.ACTIVE }
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['test'], [entry]) }).not.toThrow()
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['test'], [{ ...entry, state: FiberState.FAILED }]) }).toThrow('plugin not active')
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['test'], [{ ...entry, state: FiberState.PENDING }]) }).toThrow('plugin not active')
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['test'], []) }).toThrow('plugin not active')
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['absent'], [entry]) }).toThrow('bundle not selected')
+    value.skippedBundles.push({ packageName: 'broken', reason: 'missing dependency' })
+    expect(() =>{  requireDesktopSourceHealthPlugins(value, ['test'], [entry]) }).toThrow('plugins were skipped')
+  })
+})
