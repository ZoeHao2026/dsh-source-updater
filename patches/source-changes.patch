+    const checked = await this.observeWorker(await this.options.run('check', { ...this.options.request, manualRetry }))
+    if (this.isDisposed()) return
+    this.publish(checked)
+    if (checked.phase !== 'available' && checked.phase !== 'ready') {
+      if (['failed', 'blocked', 'rolled-back', 'recovery-required'].includes(checked.phase)) this.blockSwitch(checked)
+      else if (checked.phase !== 'check-unavailable') { this.switchBlocked = false; this.blockedTarget = undefined; this.blockedState = undefined }
