new file mode 100644
index 0000000000000000000000000000000000000000..0586a4697be6408f49bbcf35c12179a48915616d
--- /dev/null
+++ b/apps/desktop/scripts/electron-download-settings.ts
@@ -0,0 +1,15 @@
+/** Resolve a finite network deadline for the official Electron downloader. */
+
+/**
+ * Read DSH_DESKTOP_ELECTRON_DOWNLOAD_TIMEOUT_MS; absence uses fifteen minutes.
+ * @param environment Packaging environment; omitted uses the current process environment.
+ * @returns A positive integer timeout in milliseconds, at most one hour.
+ */
+export function electronDownloadTimeout(environment: NodeJS.ProcessEnv = process.env): number {
+  const value = environment.DSH_DESKTOP_ELECTRON_DOWNLOAD_TIMEOUT_MS ?? '900000'
+  const milliseconds = Number(value)
+  if (!/^[1-9]\d*$/u.test(value) || !Number.isSafeInteger(milliseconds) || milliseconds > 3_600_000) {
+    throw new Error('desktop runtime: DSH_DESKTOP_ELECTRON_DOWNLOAD_TIMEOUT_MS must be an integer from 1 to 3600000')
+  }
+  return milliseconds
+}
