+    acceptance = { path: `${requestPath}.accepted.json`, token: randomUUID() }
+    await writeFile(requestPath, `${JSON.stringify({ ...request, handoffToken: acceptance.token, handoffReceipt: acceptance.path })}\n`, { flag: 'wx', mode: 0o600 })
