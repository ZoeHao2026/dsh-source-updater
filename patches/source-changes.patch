+  const run = vi.fn(async (action: string): Promise<DesktopSourceUpdateState> => ({ phase: action === 'check' ? 'available' : action === 'apply' ? 'applying' : 'ready', target }))
+  const inspectInstall = vi.fn(async () => true)
