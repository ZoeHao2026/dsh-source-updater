+
+/** Desktop-owned collaborators; unknown work or unsaved drafts refuse installation. */
+export interface DesktopSourceUpdaterOptions {
+  readonly request: object
+  readonly run: (action: 'check' | 'prepare' | 'apply' | 'status', request: object, detached?: boolean) => Promise<DesktopSourceUpdateState>
+  readonly idleMilliseconds: () => number
+  readonly prepareInstall: () => Promise<boolean>
+  readonly recoverInstall: () => Promise<void>
+  readonly quit: () => void
+  readonly publish: (state: DesktopSourceUpdateState) => void
+}
+
+/** One launch/check/build chain per Desktop process; only a ready build schedules idle admission checks. */
+export class DesktopSourceUpdater {
+  private pending: Promise<void> | undefined
+  private admissionPending: Promise<void> | undefined
+  private timer: ReturnType<typeof setTimeout> | undefined
+  private disposed = false
+  private ready: DesktopSourceUpdateState | undefined
+  private snapshot: DesktopSourceUpdateState = { phase: 'idle' }
+
+  /** @param options - Worker, status, idle, and graceful installation capabilities. */
+  constructor(private readonly options: DesktopSourceUpdaterOptions) {}
+
+  /** Last observed helper result, for the native status and retry dialog. */
+  get state(): DesktopSourceUpdateState { return this.snapshot }
+
+  /**
+   * Check once on a cold or second launch; concurrent launches join existing work.
+   * @returns Completion of the observed check and optional background build.
+   */
+  launch(): Promise<void> {
+    if (this.disposed) return Promise.resolve()
+    if (this.pending !== undefined) return this.pending
+    if (this.admissionPending !== undefined) return this.admissionPending
+    if (this.ready !== undefined) { this.scheduleAdmission(); return Promise.resolve() }
+    const pending = this.check().catch((error: unknown) => {
+      this.publish({ phase: 'failed', detail: error instanceof Error ? error.message : String(error) })
+    }).finally(() => { if (this.pending === pending) this.pending = undefined })
+    this.pending = pending
+    return pending
+  }
+
+  /** Stop idle admission checks; an independently locked worker owns any build already started. */
+  dispose(): void {
+    this.disposed = true
+    if (this.timer !== undefined) clearTimeout(this.timer)
+    this.timer = undefined
+  }
+
+  private publish(state: DesktopSourceUpdateState): void {
+    this.snapshot = state
+    if (!this.disposed) this.options.publish(state)
+  }
+
+  private isDisposed(): boolean { return this.disposed }
+
+  private async check(): Promise<void> {
+    this.publish({ phase: 'checking' })
+    let checked = await this.options.run('check', this.options.request)
+    while (!this.isDisposed() && ['busy', 'building'].includes(checked.phase)) {
+      this.publish(checked)
+      await new Promise<void>((resolveWait) => { setTimeout(resolveWait, 1_000) })
+      if (this.isDisposed()) return
+      checked = await this.options.run('status', this.options.request)
+    }
+    if (this.isDisposed()) return
+    this.publish(checked)
+    if (checked.phase !== 'available' && checked.phase !== 'ready') return
+    if (checked.target === undefined) throw new Error('source updater: release identity missing')
+    const prepared = checked.phase === 'ready' ? checked : await this.options.run('prepare', { ...this.options.request, target: checked.target })
+    if (this.isDisposed()) return
+    this.publish(prepared)
+    if (prepared.phase !== 'ready') return
+    if (prepared.target === undefined) throw new Error('source updater: prepared release identity missing')
+    this.ready = prepared
+    this.scheduleAdmission()
+  }
+
+  private scheduleAdmission(): void {
+    if (this.disposed || this.timer !== undefined || this.ready === undefined || this.admissionPending !== undefined) return
+    this.timer = setTimeout(() => {
+      this.timer = undefined
+      const admission = this.admit().catch((error: unknown) => {
+        this.publish({ phase: 'deferred', ...(this.ready?.target === undefined ? {} : { target: this.ready.target }),
+          detail: error instanceof Error ? error.message : String(error) })
+      }).finally(() => {
+        if (this.admissionPending === admission) this.admissionPending = undefined
+        this.scheduleAdmission()
+      })
+      this.admissionPending = admission
+    }, Math.max(1_000, 60_000 - this.options.idleMilliseconds()))
+    this.timer.unref()
+  }
+
+  private async admit(): Promise<void> {
+    const ready = this.ready
+    if (this.disposed || ready?.target === undefined) return
+    if (this.options.idleMilliseconds() < 60_000) {
+      this.timer = setTimeout(() => { this.timer = undefined; this.scheduleAdmission() }, 10_000)
+      this.timer.unref()
+      return
+    }
+    const admitted = await this.options.prepareInstall()
+    if (this.isDisposed()) {
+      if (admitted) await this.options.recoverInstall()
+      return
+    }
+    if (!admitted) {
+      this.timer = setTimeout(() => { this.timer = undefined; this.scheduleAdmission() }, 10_000)
+      this.timer.unref()
+      return
+    }
+    try {
+      await this.options.run('apply', { ...this.options.request, target: ready.target,
+        admission: { hostStopped: true, draftsSaved: true, drained: true, idleMs: this.options.idleMilliseconds(),
+          activeTasks: 0, pendingApprovals: 0, queuedMessages: 0, backgroundJobs: 0, admittedAt: new Date().toISOString() } }, true)
+    } catch (error) {
+      await this.options.recoverInstall()
+      throw error
+    }
+    if (this.isDisposed()) return
+    this.publish({ phase: 'applying', target: ready.target })
+    this.dispose()
+    this.options.quit()
+  }
+}
