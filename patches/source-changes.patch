--- /dev/null
+++ b/apps/desktop/src/source-updater.ts
@@ -0,0 +1,450 @@
+/** Launch-triggered source updates; installation admission stays with the running Desktop owner. */
+
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { open, readFile, unlink, writeFile } from 'node:fs/promises'
+import { randomUUID } from 'node:crypto'
+import { dirname, isAbsolute, join, resolve } from 'node:path'
+
+/** Published release pinned by the worker before any source build. */
+export interface DesktopSourceTarget {
+  readonly version: string
+  readonly tag: string
+  readonly commit: string
+}
+
+/** Durable status returned by the local source build worker. */
+export interface DesktopSourceUpdateState {
+  readonly phase: string
+  readonly target?: DesktopSourceTarget
+  readonly detail?: string
+  readonly [key: string]: unknown
+}
+
+/** Worker operations; preflight reads the current installation before Host shutdown. */
+export type DesktopSourceUpdateAction = 'check' | 'prepare' | 'preflight' | 'apply' | 'status'
+
+/** A live or unverified helper must not race a restored Host or another installation attempt. */
+export class DesktopSourceHandoffError extends Error {
+  /** @param outcome - Rejected means the helper exited before Desktop quit; unknown requires local inspection.
+   * @param message - Private, actionable worker diagnostics.
+   */
+  constructor(readonly outcome: 'rejected' | 'unknown', message: string) { super(message) }
+}
+
+async function workerOutputTail(filename: string): Promise<string> {
+  const file = await open(filename, 'r')
+  try {
+    const size = (await file.stat()).size
+    const buffer = Buffer.alloc(Math.min(size, 16_384))
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, Math.max(0, size - buffer.length))
+    return buffer.subarray(0, bytesRead).toString('utf8')
+  } finally { await file.close() }
+}
+
+/** Local helper paths; an absent configuration leaves ordinary Desktop startup usable. */
+export interface DesktopSourceUpdaterPaths {
+  readonly worker: string
+  readonly config: string
+}
+
+/**
+ * Resolve the explicitly installed source-update helper.
+ * @param localAppData - Windows local application data directory; absent outside Windows.
+ * @param override - Explicit configuration path; when supplied, missing files never fall back to another installation.
+ * @param documentsDirectory - Optional stable Documents folder; its DSHUpdater helper takes precedence over the legacy local-data location.
+ * @returns Paths only when both helper and configuration exist.
+ */
+export function desktopSourceUpdaterPaths(
+  localAppData: string | undefined, override?: string, documentsDirectory?: string,
+): DesktopSourceUpdaterPaths | undefined {
+  const candidates = override === undefined ? [
+    ...(documentsDirectory === undefined ? [] : [join(documentsDirectory, 'DSHUpdater', 'updater-config.json')]),
+    ...(localAppData === undefined ? [] : [join(localAppData, 'DSH Source Updater', 'updater-config.json')]),
+  ] : [override]
+  for (const config of candidates) {
+    const worker = join(dirname(config), 'upgrade-worker.mjs')
+    if (existsSync(config) && existsSync(worker)) return { config, worker }
+  }
+  return undefined
+}
+
+/**
+ * Validate a worker response before allowing it to authorize a later operation.
+ * @param value - Parsed worker JSON.
+ * @returns Status with validated release identity when present.
+ */
+export function parseDesktopSourceUpdateState(value: unknown): DesktopSourceUpdateState {
+  if (typeof value !== 'object' || value === null || !('phase' in value) || typeof value.phase !== 'string') {
+    throw new Error('source updater: invalid worker status')
+  }
+  if ('target' in value && value.target !== undefined) {
+    const target = value.target
+    if (typeof target !== 'object' || target === null || !('version' in target) || typeof target.version !== 'string'
+      || !('tag' in target) || typeof target.tag !== 'string' || target.tag !== `dsh-v${target.version}`
+      || !('commit' in target) || typeof target.commit !== 'string' || !/^[0-9a-f]{40}$/u.test(target.commit)) {
+      throw new Error('source updater: invalid pinned release')
+    }
+  }
+  if ('detail' in value && value.detail !== undefined && typeof value.detail !== 'string') {
+    throw new Error('source updater: invalid worker detail')
+  }
+  return value as DesktopSourceUpdateState
+}
+
+/**
+ * Run the trusted local helper without a shell or application credentials.
+ * @param executable - Desktop executable, which must never host the worker that replaces it.
+ * @param paths - Installed worker and configuration.
+ * @param action - Worker operation.
+ * @param request - Main-process-owned request fields.
+ * @param detached - Apply uses a PID-bound durable acceptance handshake and retains private output files. Checks and builds detach with file-backed output; status and preflight use pipes.
+ * @returns Worker JSON, or an acknowledged detached apply launch.
+ */
+export async function runDesktopSourceWorker(
