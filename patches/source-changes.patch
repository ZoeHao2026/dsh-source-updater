+              if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error
+            }
+            if (receipt !== undefined) {
+              if (typeof receipt !== 'object' || receipt === null || !('token' in receipt) || receipt.token !== acceptance.token
+                || !('accepted' in receipt) || receipt.accepted !== true) throw new Error('source updater: invalid install helper acceptance')
