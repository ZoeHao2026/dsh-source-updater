diff --git a/apps/desktop/src/source-update-health.ts b/apps/desktop/src/source-update-health.ts
new file mode 100644
index 0000000000000000000000000000000000000000..490d18ace4c766d201c174c5bcd6c729e07a4597
--- /dev/null
+++ b/apps/desktop/src/source-update-health.ts
@@ -0,0 +1,107 @@
+/** Isolated source-build qualification before normal windows, launch checks, or user request admission. */
+
+import { readFileSync } from 'node:fs'
+import { readFile, writeFile } from 'node:fs/promises'
+import { isAbsolute, join, resolve } from 'node:path'
+import { homedir } from 'node:os'
+import { desktopSourceUpdaterPaths } from './source-updater.ts'
+
+/** Worker-owned qualification request, passed only on the local process command line. */
+export interface DesktopSourceHealthRequest {
+  readonly schemaVersion: 1
+  readonly token: string
+  readonly receiptPath: string
+  readonly releasePath: string
+  readonly homePath: string
+  readonly userDataPath: string
+  readonly version: string
+  readonly commit: string
+  readonly phase: 'isolated' | 'installed' | 'installed-final'
+  readonly plugins: readonly { readonly name: string; readonly version: string }[]
+}
+
+/**
+ * Read a qualification request before Electron claims its normal profile.
+ * @param argv - Local process command line.
+ * @returns Validated request, or undefined for an ordinary launch.
+ */
+export function readDesktopSourceHealthRequest(argv: readonly string[]): DesktopSourceHealthRequest | undefined {
+  const argument = argv.find(value => value.startsWith('--source-update-health='))
+  if (argument === undefined) return undefined
+  const value: unknown = JSON.parse(readFileSync(argument.slice('--source-update-health='.length), 'utf8'))
+  if (typeof value !== 'object' || value === null) throw new Error('source health: invalid request')
+  const fields = value as Record<string, unknown>
+  if (fields.schemaVersion !== 1 || typeof fields.token !== 'string' || !/^[a-zA-Z0-9_-]{16,128}$/u.test(fields.token)
+    || typeof fields.version !== 'string' || typeof fields.commit !== 'string' || !/^[0-9a-f]{40}$/u.test(fields.commit)
+    || !['isolated', 'installed', 'installed-final'].includes(String(fields.phase))) throw new Error('source health: invalid request identity')
+  for (const key of ['receiptPath', 'releasePath', 'homePath', 'userDataPath']) {
+    if (typeof fields[key] !== 'string' || !isAbsolute(fields[key])) throw new Error(`source health: invalid ${key}`)
+  }
+  const request = value as DesktopSourceHealthRequest
+  if (!Array.isArray(fields.plugins) || fields.plugins.length === 0
+    || fields.plugins.some((plugin: unknown) => typeof plugin !== 'object' || plugin === null
+      || !('name' in plugin) || typeof plugin.name !== 'string'
+      || !('version' in plugin) || typeof plugin.version !== 'string')) throw new Error('source health: expected plugins missing')
+  const samePath = (left: string, right: string): boolean => process.platform === 'win32'
+    ? resolve(left).toLowerCase() === resolve(right).toLowerCase() : resolve(left) === resolve(right)
+  const updaterPaths = desktopSourceUpdaterPaths(process.env.LOCALAPPDATA, process.env.DSH_SOURCE_UPDATER_CONFIG, join(homedir(), 'Documents'))
+  const config: unknown = updaterPaths === undefined ? undefined : JSON.parse(readFileSync(updaterPaths.config, 'utf8')) as unknown
+  const configuredHome = typeof config === 'object' && config !== null && 'sharedDataDir' in config && typeof config.sharedDataDir === 'string' ? config.sharedDataDir : undefined
+  const configuredUserData = typeof config === 'object' && config !== null && 'userDataDir' in config && typeof config.userDataDir === 'string' ? config.userDataDir : undefined
+  if (request.phase === 'installed-final') {
+    if (configuredHome === undefined || configuredUserData === undefined || !samePath(configuredHome, request.homePath)
+      || !samePath(configuredUserData, request.userDataPath)) throw new Error('source health: final data paths differ from updater configuration')
+  } else if (samePath(request.homePath, join(process.env.USERPROFILE ?? '.', '.dsh'))
+    || samePath(request.userDataPath, join(process.env.APPDATA ?? '.', 'DeepSeek Harness'))
+    || samePath(request.userDataPath, join(process.env.APPDATA ?? '.', '@deepseek-ai', 'dsh-desktop'))
+    || (configuredHome !== undefined && samePath(configuredHome, request.homePath))
+    || (configuredUserData !== undefined && samePath(configuredUserData, request.userDataPath))) {
+    throw new Error('source health: qualification requires isolated data directories')
+  }
+  return request
+}
+
+/**
+ * Inspect installed plugin versions after profile startup.
+ * @param profile - Isolated Desktop profile.
+ * @returns Installed external package versions declared by this profile.
+ */
+export async function desktopSourceHealthPluginVersions(profile: string): Promise<Record<string, string>> {
+  const manifest: unknown = JSON.parse(await readFile(join(profile, 'package.json'), 'utf8'))
+  if (typeof manifest !== 'object' || manifest === null || !('dependencies' in manifest)
+    || typeof manifest.dependencies !== 'object' || manifest.dependencies === null) throw new Error('source health: invalid profile dependencies')
+  const versions: Record<string, string> = {}
+  for (const name of Object.keys(manifest.dependencies)) {
+    if (!/^(?:@[a-z0-9._~-]+\/)?[a-z0-9._~-]+$/u.test(name)) throw new Error('source health: invalid plugin package name')
+    const installed: unknown = JSON.parse(await readFile(join(profile, 'node_modules', ...name.split('/'), 'package.json'), 'utf8'))
+    if (typeof installed !== 'object' || installed === null || !('version' in installed) || typeof installed.version !== 'string') {
+      throw new Error(`source health: plugin version unavailable: ${name}`)
+    }
+    versions[name] = installed.version
+  }
+  return versions
+}
+
+/**
+ * Publish measured readiness and wait for the worker to request graceful exit.
+ * @param request - Isolated qualification paths and expected release.
+ * @param receipt - Actual app identity and startup measurements.
+ * @returns Completion when a matching token releases the health process; fails closed after two minutes.
+ */
+export async function awaitDesktopSourceHealthRelease(request: DesktopSourceHealthRequest, receipt: object): Promise<void> {
+  await writeFile(request.receiptPath, `${JSON.stringify({ schemaVersion: 1, token: request.token, ...receipt })}\n`, { flag: 'wx' })
+  const deadline = Date.now() + 120_000
+  while (Date.now() < deadline) {
+    let release: unknown
+    try { release = JSON.parse(await readFile(request.releasePath, 'utf8')) as unknown }
+    catch (error) {
+      if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error
+      await new Promise<void>((resolveWait) => { setTimeout(resolveWait, 200) })
+      continue
+    }
+    if (typeof release !== 'object' || release === null || !('token' in release) || release.token !== request.token
+      || !('action' in release) || release.action !== 'exit') throw new Error('source health: invalid release acknowledgement')
+    return
+  }
+  throw new Error('source health: worker release timed out')
+}
