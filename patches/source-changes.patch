+    }, Math.max(1_000, 60_000 - this.options.idleMilliseconds()))
+    this.timer.unref()
+  }
+
+  private async admit(): Promise<void> {
+    const ready = this.ready
+    if (this.disposed || ready?.target === undefined) return
+    if (this.options.idleMilliseconds() < 60_000) {
+      this.timer = setTimeout(() => { this.timer = undefined; this.scheduleAdmission() }, 10_000)
+      this.timer.unref()
+      return
+    }
+    if (!await this.options.inspectInstall() || this.options.idleMilliseconds() < 60_000) {
+      this.timer = setTimeout(() => { this.timer = undefined; this.scheduleAdmission() }, 10_000)
+      this.timer.unref()
+      return
+    }
+    const verified = await this.options.run('preflight', { ...this.options.request, target: ready.target })
+    if (this.isDisposed()) return
+    if (verified.phase !== 'ready') {
+      this.blockSwitch(verified)
+      this.publish(verified)
+      return
+    }
+    if (verified.target?.commit !== ready.target.commit || verified.target.version !== ready.target.version) {
+      throw new Error('source updater: preflight returned a different release')
+    }
+    if (this.options.idleMilliseconds() < 60_000) return
+    const admitted = await this.options.prepareInstall()
+    if (this.isDisposed()) {
+      if (admitted) await this.options.recoverInstall()
+      return
+    }
+    if (!admitted) {
+      this.timer = setTimeout(() => { this.timer = undefined; this.scheduleAdmission() }, 10_000)
+      this.timer.unref()
+      return
+    }
+    try {
+      const accepted = await this.options.run('apply', { ...this.options.request, target: ready.target,
+        admission: { hostStopped: true, draftsSaved: true, drained: true, idleMs: this.options.idleMilliseconds(),
+          activeTasks: 0, pendingApprovals: 0, queuedMessages: 0, backgroundJobs: 0, admittedAt: new Date().toISOString() } }, true)
+      if (accepted.phase !== 'applying') throw new Error(accepted.detail ?? 'source updater: helper did not accept installation')
+    } catch (error) {
