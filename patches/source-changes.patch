+
+const directories: string[] = []
+afterEach(async () => { for (const directory of directories.splice(0)) await rm(directory, { recursive: true, force: true }) })
+
+async function helper(source: string) {
+  const directory = await mkdtemp(join(tmpdir(), 'dsh-handoff-test-'))
+  directories.push(directory)
+  const worker = join(directory, 'worker.mjs')
+  const config = join(directory, 'config.json')
+  await writeFile(worker, source)
+  await writeFile(config, JSON.stringify({ tools: { node: { executable: process.execPath } } }))
+  return { executable: join(directory, 'old-client.exe'), paths: { worker, config } }
+}
+
+it('keeps the original process alive when the helper exits before validating its handoff', async () => {
+  const fixture = await helper('process.exit(3)')
+  await expect(runDesktopSourceWorker(fixture.executable, fixture.paths, 'apply', { schemaVersion: 1 }, true)).rejects.toThrow('before accepting')
+})
+
+it('acknowledges only the matching durable receipt before allowing Desktop to quit', async () => {
+  const fixture = await helper(`
+    import { readFile, writeFile } from 'node:fs/promises';
+    const filename = process.argv[process.argv.indexOf('--request-path') + 1];
+    const request = JSON.parse(await readFile(filename, 'utf8'));
+    await writeFile(request.handoffReceipt, JSON.stringify({ schemaVersion: 1, workerPid: process.pid, token: request.handoffToken, accepted: true }));
+    setTimeout(() => {}, 250);
+  `)
+  await expect(runDesktopSourceWorker(fixture.executable, fixture.paths, 'apply', { schemaVersion: 1 }, true)).resolves.toEqual({ phase: 'applying' })
+})
+
+it('refuses a receipt belonging to another update attempt', async () => {
+  const fixture = await helper(`
+    import { readFile, writeFile } from 'node:fs/promises';
