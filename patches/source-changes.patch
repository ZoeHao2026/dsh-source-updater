+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, describe, expect, it } from 'vitest'
+import { desktopSourceUpdaterPaths } from '../src/source-updater.ts'
+
+const roots: string[] = []
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }) })
+
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-updater-paths-'))
+  roots.push(root)
+  const documents = join(root, 'Documents')
+  const local = join(root, 'Local')
+  const install = (config: string, withWorker = true) => {
+    mkdirSync(dirname(config), { recursive: true })
+    writeFileSync(config, '{}\n')
+    const worker = join(dirname(config), 'upgrade-worker.mjs')
+    if (withWorker) writeFileSync(worker, '// Discovery fixture.\n')
+    return { config, worker }
+  }
+  return { root, documents, local, install }
+}
+
+describe('source helper discovery', () => {
+  it('prefers stable Documents over the legacy local-data helper', () => {
+    const f = fixture()
+    f.install(join(f.local, 'DSH Source Updater', 'updater-config.json'))
+    const expected = f.install(join(f.documents, 'DSHUpdater', 'updater-config.json'))
+    expect(desktopSourceUpdaterPaths(f.local, undefined, f.documents)).toEqual(expected)
+    expect(desktopSourceUpdaterPaths(undefined, undefined, f.documents)).toEqual(expected)
+  })
+
+  it('preserves legacy local-data discovery when no complete Documents helper exists', () => {
+    const f = fixture()
+    const expected = f.install(join(f.local, 'DSH Source Updater', 'updater-config.json'))
+    f.install(join(f.documents, 'DSHUpdater', 'updater-config.json'), false)
+    expect(desktopSourceUpdaterPaths(f.local, undefined, f.documents)).toEqual(expected)
+    expect(desktopSourceUpdaterPaths(f.local)).toEqual(expected)
+  })
+
+  it('honors an explicit override and never falls back to another helper', () => {
+    const f = fixture()
+    f.install(join(f.local, 'DSH Source Updater', 'updater-config.json'))
+    f.install(join(f.documents, 'DSHUpdater', 'updater-config.json'))
+    const expected = f.install(join(f.root, 'explicit', 'custom-config.json'))
+    expect(desktopSourceUpdaterPaths(f.local, expected.config, f.documents)).toEqual(expected)
+    expect(desktopSourceUpdaterPaths(f.local, join(f.root, 'missing.json'), f.documents)).toBeUndefined()
+    const incomplete = f.install(join(f.root, 'incomplete', 'updater-config.json'), false)
+    expect(desktopSourceUpdaterPaths(f.local, incomplete.config, f.documents)).toBeUndefined()
+  })
+
+  it('returns undefined when no complete helper is installed', () => {
+    const f = fixture()
+    expect(desktopSourceUpdaterPaths(undefined)).toBeUndefined()
+    expect(desktopSourceUpdaterPaths(f.local, undefined, f.documents)).toBeUndefined()
+    f.install(join(f.documents, 'DSHUpdater', 'updater-config.json'), false)
+    expect(desktopSourceUpdaterPaths(f.local, undefined, f.documents)).toBeUndefined()
+  })
+})
diff --git a/apps/desktop/tests/source-updater.spec.ts b/apps/desktop/tests/source-updater.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b54b6b7313cd756173146257d467a1aaca237890
--- /dev/null
+++ b/apps/desktop/tests/source-updater.spec.ts
@@ -0,0 +1,182 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { DesktopSourceUpdater, parseDesktopSourceUpdateState, type DesktopSourceUpdateState } from '../src/source-updater.ts'
+
+const target = { version: '0.2.1-alpha.6', tag: 'dsh-v0.2.1-alpha.6', commit: 'a'.repeat(40) }
+const owners: DesktopSourceUpdater[] = []
+
+beforeEach(() => { vi.useFakeTimers() })
+afterEach(() => { for (const owner of owners.splice(0)) owner.dispose(); vi.useRealTimers() })
+
+function fixture() {
+  let idle = 60_000
+  const states: DesktopSourceUpdateState[] = []
+  const run = vi.fn(async (action: string): Promise<DesktopSourceUpdateState> => ({ phase: action === 'check' ? 'available' : action === 'prepare' ? 'ready' : 'applying', target }))
+  const prepareInstall = vi.fn(async () => true)
+  const recoverInstall = vi.fn(async () => {})
+  const quit = vi.fn()
+  const updater = new DesktopSourceUpdater({ request: { currentVersion: '0.2.1-alpha.5' }, run,
+    idleMilliseconds: () => idle, prepareInstall, recoverInstall, quit, publish: (state) => { states.push(state) } })
+  owners.push(updater)
+  return { updater, run, states, prepareInstall, recoverInstall, quit, input: () => { idle = 0 }, idle: () => { idle = 60_000 } }
+}
+
+describe('launch source updates', () => {
+  it('joins cold and second launches while a background build is pending', async () => {
+    const f = fixture()
+    const build = Promise.withResolvers<DesktopSourceUpdateState>()
+    f.run.mockImplementation(async action => action === 'check' ? { phase: 'available', target } : build.promise)
+    const first = f.updater.launch()
+    await Promise.resolve()
+    const second = f.updater.launch()
+    expect(second).toBe(first)
+    build.resolve({ phase: 'ready', target })
+    await first
+    expect(f.run.mock.calls.map(call => call[0])).toEqual(['check', 'prepare'])
+    expect(f.quit).not.toHaveBeenCalled()
+  })
+
+  it('has no timer and no build when no newer published release exists', async () => {
+    const f = fixture()
+    f.run.mockResolvedValue({ phase: 'current' })
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(24 * 60 * 60_000)
+    expect(f.run).toHaveBeenCalledOnce()
+    expect(vi.getTimerCount()).toBe(0)
+    expect(f.quit).not.toHaveBeenCalled()
+  })
+
+  it('retains the running app on offline checks, build failure, and incompatible plugins', async () => {
+    for (const phase of ['failed', 'blocked']) {
+      const f = fixture()
+      f.run.mockImplementation(async action => action === 'check' ? { phase: 'available', target } : { phase, target, detail: 'plugin unavailable' })
+      await f.updater.launch()
+      await vi.advanceTimersByTimeAsync(120_000)
+      expect(f.quit).not.toHaveBeenCalled()
+      expect(f.updater.state.phase).toBe(phase)
+      expect(vi.getTimerCount()).toBe(0)
+    }
+    const offline = fixture()
+    offline.run.mockRejectedValue(new Error('offline'))
+    await offline.updater.launch()
+    expect(offline.updater.state).toMatchObject({ phase: 'failed', detail: 'offline' })
+  })
+
+  it('does not apply during user input or active work, then hands off after guarded idle', async () => {
+    const f = fixture()
+    f.input()
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(60_000)
+    expect(f.prepareInstall).not.toHaveBeenCalled()
+    f.idle()
+    f.prepareInstall.mockResolvedValueOnce(false)
+    await vi.advanceTimersByTimeAsync(11_000)
+    expect(f.prepareInstall).toHaveBeenCalledOnce()
+    expect(f.quit).not.toHaveBeenCalled()
+    await vi.advanceTimersByTimeAsync(11_000)
+    expect(f.quit).toHaveBeenCalledOnce()
+    const apply = f.run.mock.calls.find(call => call[0] === 'apply')
+    expect(apply).toBeDefined()
+  })
+
+  it('restores the stopped host when the detached helper cannot start', async () => {
+    const f = fixture()
+    f.run.mockImplementation(async (action) => {
+      if (action === 'apply') throw new Error('spawn failed')
+      return { phase: action === 'check' ? 'available' : 'ready', target }
+    })
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(1_000)
+    expect(f.recoverInstall).toHaveBeenCalledOnce()
+    expect(f.quit).not.toHaveBeenCalled()
+    expect(f.updater.state.phase).toBe('deferred')
+  })
+
+  it('cancels idle admission on shutdown without cancelling an independently owned build', async () => {
+    const f = fixture()
+    await f.updater.launch()
+    f.updater.dispose()
+    await vi.advanceTimersByTimeAsync(60_000)
+    expect(f.prepareInstall).not.toHaveBeenCalled()
+    expect(f.quit).not.toHaveBeenCalled()
+  })
+
+  it('joins second launches while task drain and graceful shutdown are pending', async () => {
+    const f = fixture()
+    const admission = Promise.withResolvers<boolean>()
+    f.prepareInstall.mockReturnValue(admission.promise)
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(1_000)
+    expect(f.prepareInstall).toHaveBeenCalledOnce()
+    const second = f.updater.launch()
+    const third = f.updater.launch()
+    expect(third).toBe(second)
+    await vi.advanceTimersByTimeAsync(60_000)
+    expect(f.prepareInstall).toHaveBeenCalledOnce()
+    expect(f.run.mock.calls.filter(call => call[0] === 'apply')).toHaveLength(0)
+    admission.resolve(true)
+    await second
+    expect(f.run.mock.calls.filter(call => call[0] === 'apply')).toHaveLength(1)
+    expect(f.quit).toHaveBeenCalledOnce()
+    await vi.advanceTimersByTimeAsync(60_000)
+    await f.updater.launch()
+    expect(f.prepareInstall).toHaveBeenCalledOnce()
+    expect(f.quit).toHaveBeenCalledOnce()
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('recovers a prepared Host without handing off when shutdown cancels pending admission', async () => {
+    const f = fixture()
+    const admission = Promise.withResolvers<boolean>()
+    f.prepareInstall.mockReturnValue(admission.promise)
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(1_000)
+    const pending = f.updater.launch()
+    f.updater.dispose()
+    admission.resolve(true)
+    await pending
+    expect(f.recoverInstall).toHaveBeenCalledOnce()
+    expect(f.run.mock.calls.filter(call => call[0] === 'apply')).toHaveLength(0)
+    expect(f.quit).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('does not recover an unprepared Host or rearm a timer after shutdown', async () => {
+    const f = fixture()
+    const admission = Promise.withResolvers<boolean>()
+    f.prepareInstall.mockReturnValue(admission.promise)
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(1_000)
+    const pending = f.updater.launch()
+    f.updater.dispose()
+    admission.resolve(false)
+    await pending
+    expect(f.recoverInstall).not.toHaveBeenCalled()
+    expect(f.quit).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('does not quit again when application shutdown overlaps an accepted helper handoff', async () => {
+    const f = fixture()
+    const handoff = Promise.withResolvers<DesktopSourceUpdateState>()
+    f.run.mockImplementation(async action => action === 'apply' ? handoff.promise : { phase: action === 'check' ? 'available' : 'ready', target })
+    await f.updater.launch()
+    await vi.advanceTimersByTimeAsync(1_000)
+    const pending = f.updater.launch()
+    f.updater.dispose()
+    handoff.resolve({ phase: 'applying', target })
+    await pending
+    expect(f.recoverInstall).not.toHaveBeenCalled()
+    expect(f.quit).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+  })
+})
+
+describe('worker JSON', () => {
+  it('requires an official tag and immutable full commit before build admission', () => {
+    expect(parseDesktopSourceUpdateState({ phase: 'ready', target })).toMatchObject({ target })
+    expect(() => parseDesktopSourceUpdateState({ phase: 'ready', target: { ...target, tag: 'main' } })).toThrow('invalid pinned')
+    expect(() => parseDesktopSourceUpdateState({ phase: 'ready', target: { ...target, commit: 'main' } })).toThrow('invalid pinned')
+    expect(() => parseDesktopSourceUpdateState({ phase: 'ready', detail: 5 })).toThrow('invalid worker detail')
+    expect(() => parseDesktopSourceUpdateState(null)).toThrow('invalid worker status')
+  })
+})
