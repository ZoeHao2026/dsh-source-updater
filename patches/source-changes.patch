+              } catch (error) {
+                // Startup failures may emit only stderr, before worker JSON exists.
+                if (!(error instanceof Error)) throw error
+              }
+              throw new DesktopSourceHandoffError('rejected',
+                `source updater: install helper exited before accepting (${String(exitCode)}). ${detail || diagnostic}\nLog: ${files.stderr}`)
+            }
+            let receipt: unknown
+            try { receipt = JSON.parse(await readFile(acceptance.path, 'utf8')) as unknown }
+            catch (error) {
+              if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error
+            }
+            if (receipt !== undefined) {
+              if (typeof receipt !== 'object' || receipt === null || !('token' in receipt) || receipt.token !== acceptance.token
+                || !('accepted' in receipt) || receipt.accepted !== true
+                || !('schemaVersion' in receipt) || receipt.schemaVersion !== 1
+                || !('workerPid' in receipt) || receipt.workerPid !== child.pid) {
+                throw new DesktopSourceHandoffError('unknown', 'source updater: invalid install helper acceptance; inspect the helper before retrying')
+              }
