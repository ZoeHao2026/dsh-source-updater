diff --git a/apps/desktop-host/src/source-update-health.ts b/apps/desktop-host/src/source-update-health.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d08480b46add6f937250d2171205ed3631d0b5a
--- /dev/null
+++ b/apps/desktop-host/src/source-update-health.ts
@@ -0,0 +1,59 @@
+/** Prevent copied schedules and optional background launches during source-build qualification. */
+
+import type { Profile } from '@deepseek-ai/dsh-app-boot'
+import { FiberState } from '@deepseek-ai/cordis'
+
+/** Loader facts measured after startup, without activating saved sessions. */
+export interface DesktopSourceHealthEntry {
+  readonly id: string
+  readonly name: string
+  readonly disabled: boolean
+  readonly state: FiberState | undefined
+}
+
+/**
+ * Require selected external bundles and each of their inserted Host rows to be active.
+ * @param profile - The exact profile that booted in isolation.
+ * @param expected - Required bundle package names from the worker's pinned plugin inventory.
+ * @param entries - Actual Loader entries after startup.
+ */
+export function requireDesktopSourceHealthPlugins(
+  profile: Profile, expected: readonly string[], entries: readonly DesktopSourceHealthEntry[],
+): void {
+  if (profile.skippedBundles.length > 0) throw new Error('source health: plugins were skipped')
+  for (const name of expected) {
+    const layer = profile.layers.find(item => item.packageName === name)
+    if (layer === undefined) throw new Error(`source health: bundle not selected: ${name}`)
+    const rows = layer.patches.flatMap(patch => patch.insert ?? [])
+    if (rows.length === 0) throw new Error(`source health: bundle has no verifiable Host rows: ${name}`)
+    for (const row of rows) {
+      const entry = entries.find(item => item.id === row.id && item.name === row.name)
+      if (entry === undefined || entry.disabled || entry.state !== FiberState.ACTIVE) {
+        throw new Error(`source health: plugin not active: ${name} (${row.id})`)
+      }
+    }
+  }
+}
+
+/**
+ * Disable every scheduling row before the profile mounts any plugin.
+ * @param profile - Isolated profile loaded for source-build qualification.
+ * @returns Number of scheduler row ids explicitly disabled.
+ */
+export function disableDesktopSourceHealthSchedules(profile: Profile): number {
+  const ids = new Set<string>(['schedule'])
+  const visit = (value: unknown): void => {
+    if (Array.isArray(value)) { for (const item of value) visit(item); return }
+    if (typeof value !== 'object' || value === null) return
+    const record = value as Record<string, unknown>
+    if (record.name === '@deepseek-ai/dsh-schedule') {
+      if (typeof record.id !== 'string' || record.id === '') throw new Error('source health: scheduler has no stable row id')
+      ids.add(record.id)
+    }
+    for (const child of Object.values(record)) visit(child)
+  }
+  for (const layer of profile.layers) visit(layer.patches)
+  visit(profile.patches)
+  for (const id of ids) profile.patches.push({ id, disabled: true })
+  return ids.size
+}
